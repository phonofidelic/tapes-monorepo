# apps/web-client — copy to .env.local (or run `yarn workspace web-client pull`).
# See apps/web-client/README.md.

# Optional build-time override for the sync-server URL (e.g. a Vercel deploy).
# Leave unset to derive `<origin>/sync` from window.location.
VITE_SYNC_SERVER_URL=

# The following are normally set by the build/dev scripts, not by hand:
#   HTTPS=true               # serve the Vite dev server over TLS (set by dev:https)
#   LOCAL_NETWORK_IP=...      # LAN IP, from `ipconfig getifaddr en0` on macOS
#   VITE_SERVED_BY_HOST=true  # set by electron-client's stage-web-client: the
#                             # Electron host serves this bundle to LAN guests,
#                             # so it is built with no PWA packaging at all
